{
  "name": "ud-figma-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Figma plugins: Dark Theme Automator, Data Filler, Contrast Checker, Spacing Tokens.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
