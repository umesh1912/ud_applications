{
  "name": "dark-theme-automator",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin: turn the colours in a design into Light/Dark colour variables and bind them in one click.",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --target=es2017 --outfile=code.js",
    "watch": "esbuild src/code.ts --bundle --target=es2017 --outfile=code.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
