{
  "name": "@shivam/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "build:app": "tsc -p tsconfig.json && VITE_LOCAL=1 vite build --outDir dist-app && cap sync android",
    "apk": "npm run build:app && cd android && ./gradlew assembleRelease && echo APK: android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
