{
  "name": "@shivam/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings dist/index.js",
    "seed": "tsx src/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
